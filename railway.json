{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci && npm run build && python manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": [
      "python manage.py migrate"
    ],
    "startCommand": "gunicorn naiwebsite.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 60 --log-level info --access-logfile - --error-logfile -",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
