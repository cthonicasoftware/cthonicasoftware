{
  "scripts": {
    "dev": "npx tailwindcss -i ./static/src/input.css -o ./static/src/styles.css --watch",
    "build": "npx tailwindcss -i ./static/src/input.css -o ./static/src/styles.css --minify",
    "build:django": "npm run build && python manage.py collectstatic --noinput"
  },

  "devDependencies": {
    "prettier": "latest"
  },

  "dependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "flowbite": "^3.1.2",
    "tailwindcss": "^4.1.16"
  }
}
